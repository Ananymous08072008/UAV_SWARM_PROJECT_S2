<?xml version="1.0" ?>
<!--
  uavx_disaster - UAV-X Stage 2 disaster site (earthquake / landslide survey).

  Local frame is ENU (x East, y North, z Up) with the origin at the GCS, exactly as in
  the Python simulator (config/scenario.yaml):

    GCS mast + operational centre ..... (0, 0), antenna 10 m up
    launch pads (6) ................... x = -25, y = +-12.5 / +-37.5 / +-62.5 (25 m apart)
    operational area (yellow outline) . x = 75..1075, y = -500..500  (1000 m x 1000 m)

  ArduPilot SITL's home is CMAC, so the world origin is pinned to CMAC too: a UAV's
  GPS latitude/longitude minus CMAC gives its position in this frame.
  PoI markers are not in this file: uavx_swarm scenario_manager spawns them when each
  PoI appears (red 5 m x 5 m pads, seen by the nadir camera).
-->
<sdf version="1.9">
  <world name="uavx_disaster">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-altimeter-system" name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.62 0.74 0.86 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-35.363261</latitude_deg>
      <longitude_deg>149.165230</longitude_deg>
      <elevation>584.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>3000 3000</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>3000 3000</size></plane></geometry>
          <material>
            <ambient>0.42 0.40 0.36 1</ambient>
            <diffuse>0.42 0.40 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- operational area outline (visual only): x 75..1075, y -500..500 -->
    <model name="operational_area">
      <static>true</static>
      <link name="link">
        <visual name="west">
          <pose>75 0 0.02 0 0 0</pose>
          <geometry><box><size>0.6 1000 0.02</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
        <visual name="east">
          <pose>1075 0 0.02 0 0 0</pose>
          <geometry><box><size>0.6 1000 0.02</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
        <visual name="south">
          <pose>575 -500 0.02 0 0 0</pose>
          <geometry><box><size>1000 0.6 0.02</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
        <visual name="north">
          <pose>575 500 0.02 0 0 0</pose>
          <geometry><box><size>1000 0.6 0.02</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ground control station: shelter + 10 m antenna mast at the origin -->
    <model name="gcs">
      <static>true</static>
      <link name="link">
        <collision name="shelter_collision">
          <pose>0 -4 1.25 0 0 0</pose>
          <geometry><box><size>4 3 2.5</size></box></geometry>
        </collision>
        <visual name="shelter">
          <pose>0 -4 1.25 0 0 0</pose>
          <geometry><box><size>4 3 2.5</size></box></geometry>
          <material><ambient>0.2 0.35 0.2 1</ambient><diffuse>0.2 0.35 0.2 1</diffuse></material>
        </visual>
        <collision name="mast_collision">
          <pose>0 0 5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>10</length></cylinder></geometry>
        </collision>
        <visual name="mast">
          <pose>0 0 5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>10</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <visual name="antenna">
          <pose>0 0 10.4 0 0 0</pose>
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.3 0.3 0.3 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- operational centre: 10 m x 10 m apron around the GCS -->
    <model name="operational_centre">
      <static>true</static>
      <link name="link">
        <visual name="apron">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>10 10 0.02</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- launch / recharge pads (UAV i spawns on pad i) -->
    <model name="launch_pads">
      <static>true</static>
      <link name="link">
        <visual name="pad1"><pose>-25 -12.5 0.015 0 0 0</pose><geometry><box><size>4 4 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="pad2"><pose>-25 12.5 0.015 0 0 0</pose><geometry><box><size>4 4 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="pad3"><pose>-25 -37.5 0.015 0 0 0</pose><geometry><box><size>4 4 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="pad4"><pose>-25 37.5 0.015 0 0 0</pose><geometry><box><size>4 4 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="pad5"><pose>-25 -62.5 0.015 0 0 0</pose><geometry><box><size>4 4 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="pad6"><pose>-25 62.5 0.015 0 0 0</pose><geometry><box><size>4 4 0.03</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- collapsed buildings / landslide debris inside the operational area -->
    <model name="rubble">
      <static>true</static>
      <link name="link">
        <collision name="b1c"><pose>130 75 4 0 0 0.3</pose><geometry><box><size>18 12 8</size></box></geometry></collision>
        <visual name="b1"><pose>130 75 4 0 0 0.3</pose><geometry><box><size>18 12 8</size></box></geometry>
          <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material></visual>
        <collision name="b2c"><pose>110 -90 3 0.15 0.1 -0.4</pose><geometry><box><size>24 16 6</size></box></geometry></collision>
        <visual name="b2"><pose>110 -90 3 0.15 0.1 -0.4</pose><geometry><box><size>24 16 6</size></box></geometry>
          <material><ambient>0.5 0.47 0.43 1</ambient><diffuse>0.5 0.47 0.43 1</diffuse></material></visual>
        <collision name="b3c"><pose>240 20 6 0 0 0.9</pose><geometry><box><size>14 14 12</size></box></geometry></collision>
        <visual name="b3"><pose>240 20 6 0 0 0.9</pose><geometry><box><size>14 14 12</size></box></geometry>
          <material><ambient>0.6 0.57 0.52 1</ambient><diffuse>0.6 0.57 0.52 1</diffuse></material></visual>
        <collision name="b4c"><pose>420 -160 2.5 0 0.2 0.2</pose><geometry><box><size>40 20 5</size></box></geometry></collision>
        <visual name="b4"><pose>420 -160 2.5 0 0.2 0.2</pose><geometry><box><size>40 20 5</size></box></geometry>
          <material><ambient>0.48 0.45 0.4 1</ambient><diffuse>0.48 0.45 0.4 1</diffuse></material></visual>
        <collision name="b5c"><pose>600 230 7 0 0 -0.6</pose><geometry><box><size>20 30 14</size></box></geometry></collision>
        <visual name="b5"><pose>600 230 7 0 0 -0.6</pose><geometry><box><size>20 30 14</size></box></geometry>
          <material><ambient>0.58 0.55 0.5 1</ambient><diffuse>0.58 0.55 0.5 1</diffuse></material></visual>
        <collision name="slide_c"><pose>800 -300 4 0.08 0 0.5</pose><geometry><box><size>120 40 8</size></box></geometry></collision>
        <visual name="slide"><pose>800 -300 4 0.08 0 0.5</pose><geometry><box><size>120 40 8</size></box></geometry>
          <material><ambient>0.45 0.36 0.27 1</ambient><diffuse>0.45 0.36 0.27 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
