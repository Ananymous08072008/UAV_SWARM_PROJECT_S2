<?xml version="1.0" ?>
<!-- PoI marker: a 5 m x 5 m red ground target with a white centre, seen by the
     nadir survey camera. Spawned by uavx_swarm scenario_manager when a PoI appears. -->
<sdf version="1.9">
  <model name="poi_marker">
    <static>true</static>
    <link name="link">
      <visual name="target">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><box><size>5 5 0.04</size></box></geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
          <emissive>0.25 0 0 1</emissive>
        </material>
      </visual>
      <visual name="centre">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry><box><size>1 1 0.02</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
